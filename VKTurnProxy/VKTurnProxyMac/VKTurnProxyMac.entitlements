<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Mac twin of VKTurnProxy.entitlements. Same NE capability, same
	     App Group and keychain group (spelled once in code — see
	     VKCookieStore / SharedLogger), minus wifi-info, which is iOS-only. -->
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.vkturnproxy.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.vkturnproxy.shared</string>
	</array>
	<!-- App Sandbox: a macOS packet-tunnel APP extension is only loaded from a
	     sandboxed host. network.client is the app's own HTTPS (VK API, captcha
	     probe, speed test); user-selected files are the backup import/export
	     panels. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
